# Documentation only: ASP.NET Core does not automatically load .env files.
# Local development reference: set these in PowerShell before starting the API.
# For Docker, preserve the image's URLS and /app/data connection defaults;
# use a separate env file for intentional overrides such as the write key.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__OpsPulse=Data Source=storage/opspulse.db
Cors__FrontendOrigin=http://localhost:4200
# Generate your own random key (at least 32 characters). Never put it in Angular.
# If omitted, incident writes return 503; public reads still work.
# IncidentApi__WriteKey=
